# Application Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME="AdminHub Backend"
APP_TIMEZONE="UTC"
DEFAULT_CURRENCY="USD"
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=db-password
DB_NAME=admin_hub_db
DB_SCHEMA=public
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis Configuration (Gracefully falls back to in-memory cache if offline)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis-password
REDIS_TTL_SECONDS=60
REDIS_ENABLED=true

# JWT Authentication
JWT_SECRET=admin_hub_super_secret_jwt_production_grade_key_2026
JWT_EXPIRATION=86400s

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=10
